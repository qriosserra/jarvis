# ── Discord ──────────────────────────────────────────────
# IMPORTANT: In addition to these credentials, you must enable these
# privileged Gateway Intents in the Discord Developer Portal
# (https://discord.com/developers/applications → your app → Bot):
#   • MESSAGE CONTENT INTENT  — required to read message text
#   • SERVER MEMBERS INTENT   — required for member lookup, rename,
#     move, mute, deafen, and voice speaker attribution
# Without these, the bot will crash at login with "Used disallowed intents".
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Interaction ──────────────────────────────────────────
# Enable LLM-based classification of messages that do not @mention or
# reply to the bot. When true, every otherwise-unhandled guild message
# triggers a small LLM call; keep off unless you want that cost.
INDIRECT_DETECTION_ENABLED=false

# When true, deterministic action outcomes (join-voice, move-member,
# mute/deafen-member, rename-member, send-text-message — both success
# and failure) are rephrased by the response LLM in the active persona's
# voice instead of using the hard-coded factual message. Adds one LLM
# call per action; keep off to save tokens.
ACTION_NATURAL_RESPONSE_ENABLED=false

# DEV ONLY — When true, every non-bot guild message bypasses detection and
# is forwarded to Jarvis (trigger logged as 'dev-all'). Never enable in production.
RESPOND_TO_ALL_MESSAGES=false

# ── LLM provider routing ────────────────────────────────
# Indirect-detection classifier. Both provider and model are required when
# INDIRECT_DETECTION_ENABLED=true (no fallback).
LLM_INDIRECT_DETECTION_PROVIDER=
LLM_INDIRECT_DETECTION_MODEL=

LLM_INTERPRETATION_PROVIDER=xai
LLM_INTERPRETATION_MODEL=grok-3-mini

LLM_RESPONSE_PROVIDER=xai
LLM_RESPONSE_MODEL=grok-3-mini

LLM_EMBEDDING_PROVIDER=voyage
LLM_EMBEDDING_MODEL=voyage-4-lite

# ── LLM APIs keys ────────────────────────────────────────
# OPENAI_API_KEY=
XAI_API_KEY=
VOYAGE_API_KEY=

# ── Speech-to-text ───────────────────────────────────────
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# ── Text-to-speech ───────────────────────────────────────
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=

# ── Web research ─────────────────────────────────────────
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# ── Persona ──────────────────────────────────────────────
DEFAULT_PERSONA=jarvis

# ── Observability ────────────────────────────────────────
# Set to enable OpenTelemetry tracing and metrics export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Application ──────────────────────────────────────────
NODE_ENV=development

# ── Logging ──────────────────────────────────────────────
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs/jarvis.log
LOG_DB_ENABLED=false
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
